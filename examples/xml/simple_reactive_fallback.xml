<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="BehaviorTree">
  <!-- ////////// -->
  <BehaviorTree ID="BehaviorTree">
    <ReactiveFallback>
      <Condition ID="SimpleConditionA"/>
      <Condition ID="SimpleConditionB"/>
      <Sequence>
        <Action ID="PrintMessage"
                message="Simulating long-running task..."/>
        <Action ID="Wait"
                seconds="10"/>
        <Action ID="PrintMessage"
                message="Task completed because conditions never triggered..."/>
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="PrintMessage"
            editable="true">
      <input_port name="message"
                  type="std::string"/>
    </Action>
    <Condition ID="SimpleConditionA"
               editable="true"/>
    <Condition ID="SimpleConditionB"
               editable="true"/>
    <Action ID="Wait"
            editable="true">
      <input_port name="seconds"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
