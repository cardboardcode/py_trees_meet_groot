<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="BehaviorTree">
  <!-- ////////// -->
  <BehaviorTree ID="BehaviorTree">
    <Sequence>
      <Action ID="PrintMessage"
              message="Waiting start."/>
      <Action ID="Wait"
              seconds="10"/>
      <Action ID="PrintMessage"
              message="Waiting done."/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="PrintMessage"
            editable="true">
      <input_port name="message"
                  type="std::string"/>
    </Action>
    <Action ID="Wait"
            editable="true">
      <input_port name="seconds"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
