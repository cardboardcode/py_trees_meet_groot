<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="BehaviorTree">
  <!-- ////////// -->
  <BehaviorTree ID="BehaviorTree">
    <Sequence>
      <Repeat num_cycles="5">
        <Action ID="PrintMessage"
                message="Hello World!"/>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="PrintMessage"
            editable="true">
      <input_port name="message"/>
    </Action>
  </TreeNodesModel>

</root>
