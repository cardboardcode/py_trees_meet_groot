<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3"
      main_tree_to_execute="BehaviorTree">
  <!-- ////////// -->
  <BehaviorTree ID="BehaviorTree">
    <Sequence>
      <SetBlackboard value="-2"
                     output_key="wp"/>
      <Delay delay_msec="4000">
        <AlwaysSuccess/>
      </Delay>
      <BlackboardCheckInt return_on_mismatch="FAILURE"
                          value_A="{wp}"
                          value_B="-2">
        <AlwaysSuccess/>
      </BlackboardCheckInt>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel/>

</root>
