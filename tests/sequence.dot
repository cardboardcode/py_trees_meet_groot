digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
sequence [label="Ⓜ sequence", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
move_to_door [label="move_to_door", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
sequence -> move_to_door;
selector [label="Ⓜ selector", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
sequence -> selector;
inverter [label=inverter, shape=ellipse, style=filled, fillcolor=ghostwhite, fontsize=9, fontcolor=black];
selector -> inverter;
check_door_close [label="check_door_close", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
inverter -> check_door_close;
open_door [label="open_door", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
selector -> open_door;
destroy_door [label="destroy_door", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
selector -> destroy_door;
cross_door [label="cross_door", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
sequence -> cross_door;
}
